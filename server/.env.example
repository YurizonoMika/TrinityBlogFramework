# ============================================================
# 任天堂 Switch Online (NSO) 活动集成 — 可选配置
# ============================================================
#
# ⚠️ nxapi 的客户端凭据（znca 代理地址 / Client ID / Client Secret）
#    现在只在「用户设置 → 活动集成 → Nintendo → 开发者凭据」中配置，
#    不再从本文件读取。获取方法见 README 的「Nintendo Switch Online（NSO）配置」。
#
# 下面这些是 nxapi 运行时的底层开关，通常无需改动。

# 使用远程配置（远程配置当前将 coral 设为 null，会禁用直连认证）
# NXAPI_ENABLE_REMOTE_CONFIG=1

# 使用自己的 nxapi 配置（file:// 或 http(s)://）
# NXAPI_CONFIG_URL=file:///absolute/path/to/nxapi-config.json

# 强制使用某个第三方 f 生成服务（imink / flapg）
# NXAPI_ZNCA_API=imink
# NXAPI_ZNCA_API=flapg
